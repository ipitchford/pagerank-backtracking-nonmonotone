{
 "definitions": {
  "excursion": "(max_grid pi - max(pi_0,pi_inf)) + (min(pi_0,pi_inf) - min_grid pi); relative = excursion/pi_1(i); stats over nonmonotone vertices",
  "kernel": "(i,j)->(j,k), k~j, weight (1+(mu-1)[k==i])/(d_j-1+mu)",
  "mu_grid": "np.unique(concat(linspace(0,1,101), geomspace(1,1000,200))) then mu->inf (pi_inf)",
  "mu_grid_size_finite": 300,
  "nonmonotone": "consecutive differences along grid (incl. pi_inf) contain one > tol and one < -tol",
  "nonmonotone_mu_0_1": "same, restricted to grid points mu<=1",
  "pi_inf": "(v+eps P v)/(1+eps), P=A D^-1",
  "residual_bound": "r=P^2 v - v; bound=eps^2/(1-eps^2)*||r||_1; certified pair: |pi_inf(i)-pi_inf(j)|>bound",
  "residual_certified_pairs_with_grid_order_change": "certified pairs whose sign (beyond tol) at some grid point differs from the pi_inf sign (consistency check)",
  "restart": "u_(i,j)=v_i/d_i, v uniform",
  "rounding": "floats rounded to 6 significant figures",
  "score": "pi_mu(i)=sum_{j~i} q(i,j), q=(1-eps)u+eps Q_mu q",
  "shortcut_wrong": "vertices with sign(pi_0-pi_1) != -sign(pi_inf-pi_1), both nonzero beyond tol; fraction over all n vertices",
  "tolerance": "tol = 1e-12 * max over grid and vertices of pi",
  "transient_reversal": "pairs with sign(pi_0 diff)==sign(pi_inf diff)!=0 and some grid point with the opposite sign (margins > tol)"
 },
 "description": "Prevalence of non-monotone vertex scores pi_mu in backtracking-weighted PageRank (tail projection), uniform restart v_i=1/n, graphs = LCC of 2-core.",
